__pycache__/
*.py[cod]
.venv/
dist/
build/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
# built graphs and vector stores are derived data, never committed; the
# snapshots beside them are small metric records and are tracked
.connectomekg/*
!.connectomekg/snapshots/
# Build reports -- one is written per `connkg build` run, so routine rebuilds
# would otherwise pile up in the diff. They are good provenance (host, versions,
# input digests, stage timings, peak memory), so keep the ones worth keeping
# deliberately:  git add -f reports/build_<date>.md
reports/build_*.md
# real connectome downloads (FlyWire is CC BY-NC-SA; keep it out of the repo)
data/
fafb_v783/
.DS_Store
uv.lock

# === KG generated artifacts (normalized across the fleet) ===
# Databases, vector indexes and model caches are transient and
# reproducible. snapshots/ is TRACKED and must never be ignored --
# never use a bare `**/.<ns>/` pattern here, it swallows snapshots too.

**/.pycodekg/*.sqlite
**/.pycodekg/*.sqlite-shm
**/.pycodekg/*.sqlite-wal
**/.pycodekg/*.db
**/.pycodekg/models

**/.dockg/*.sqlite
**/.dockg/*.sqlite-shm
**/.dockg/*.sqlite-wal
**/.dockg/*.db
**/.dockg/models
**/.dockg/embeddings.json

# Agent scratch dirs (Claude Code / Codex)
.agents/
.codex/

# MCP server config -- machine-specific, contains absolute paths
.mcp.json
.mcp.json.sav
# === end KG generated artifacts ===
