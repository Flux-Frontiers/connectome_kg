{
  "mcpServers": {
    "pycodekg": {
      "command": "${HOME}/.local/bin/pycodekg",
      "args": [
        "mcp",
        "--repo",
        "."
      ]
    },
    "dockg": {
      "command": "${HOME}/.local/bin/dockg-mcp",
      "args": [
        "--repo",
        "."
      ]
    },
    "connkg": {
      "command": ".venv/bin/connkg-mcp",
      "args": [
        "--root",
        "."
      ]
    }
  }
}
